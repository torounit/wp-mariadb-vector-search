{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": null,
	"testsEnvironment": false,
	"autoPort": true,
	"plugins": [
		".",
		"https://downloads.wordpress.org/plugin/ai-provider-for-google.zip",
		"https://downloads.wordpress.org/plugin/ai-provider-for-openai.zip",
		"https://downloads.wordpress.org/plugin/ai.zip",
		"torounit/ai-provider-for-lm-studio"
	],
	"config": {
		"WP_DEVELOPMENT_MODE": "plugin",
		"WP_ENVIRONMENT_TYPE": "development",
		"WP_DEBUG": true,
		"LM_STUDIO_SERVER_URL": "http://host.docker.internal:1234",
		"WP_DEBUG_LOG": "/var/www/html/wp-content/plugins/wp-mariadb-vector-search/tests/_output/debug.log"
	},
	"phpVersion": "8.4",
	"lifecycleScripts": {
		"afterStart": "wp-env run cli wp rewrite structure /%postname%/ --hard"
	}
}

{
	"name": "torounit/wp-mariadb-vector-search",
	"description": "WordPress plugin for MariaDB vector search.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.2"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "*",
		"phpcompatibility/php-compatibility": "*",
		"phpcompatibility/phpcompatibility-wp": "*",
		"phpunit/phpunit": "^9.6",
		"wp-coding-standards/wpcs": "^3.0",
		"wp-phpunit/wp-phpunit": "^6.9",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"WP_MariaDB_Vector_Search\\": "includes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"WP_MariaDB_Vector_Search\\Tests\\Integration\\": "tests/phpunit/integration/",
			"WP_MariaDB_Vector_Search\\Tests\\Unit\\": "tests/phpunit/unit/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"test": "phpunit"
	}
}
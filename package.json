{
	"name": "wp-mariadb-vector-search",
	"version": "0.1.0",
	"description": "WordPress plugin for MariaDB vector search.",
	"license": "GPL-2.0-or-later",
	"private": true,
	"wpPlugin": {
		"name": "wp_mariadb_vector_search",
		"handlePrefix": "wp_mariadb_vector_search",
		"pages": [
			"wp-mariadb-vector-search"
		]
	},
	"scripts": {
		"wp-env": "wp-env",
		"build:js": "wp-build",
		"start:js": "wp-build --watch",
		"build": "npm run build:js",
		"start": "npm run start:js",
		"test:php": "npm-run-all test:php:setup test:php:base",
		"test:php:setup": "wp-env --config=.wp-env.test.json start",
		"test:php:base": "wp-env --config=.wp-env.test.json run --env-cwd='wp-content/plugins/wp-mariadb-vector-search' wordpress vendor/bin/phpunit -c phpunit.xml.dist"
	},
	"devDependencies": {
		"@types/react": "^18.3.28",
		"@types/react-dom": "^18.3.7",
		"@wordpress/build": "^0.14.0",
		"@wordpress/env": "^11.6.0",
		"npm-run-all": "^4.1.5",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@wordpress/admin-ui": "^2.0.0",
		"@wordpress/api-fetch": "^7.44.0",
		"@wordpress/components": "^32.6.0",
		"@wordpress/element": "^6.44.0",
		"@wordpress/i18n": "^6.17.0",
		"@wordpress/notices": "^5.44.0",
		"react": "^18.3.1"
	},
	"engines": {
		"node": ">=22.21.1",
		"npm": ">=10.9.4"
	},
	"overrides": {
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	}
}
